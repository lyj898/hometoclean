---
import BaseLayout from '../layouts/BaseLayout.astro';
import { urls } from '../lib/urls';
import { meta } from '../lib/seo';

const path = urls.privacy();
const { title, description } = meta(
  'Privacy Policy | HomeToClean',
  'How HomeToClean collects, uses and discloses personal data under the Singapore Personal Data Protection Act, including disclosure to matched vendors.',
);
---

<BaseLayout title={title} description={description} path={path} batch={0}
  crumbs={[{ name: 'Privacy Policy', path: urls.privacy() }]}>
  <h1>Privacy Policy</h1>
  <p>How HomeToClean collects, uses and discloses personal data under the Singapore Personal Data Protection Act, including disclosure to matched vendors.</p>
  <p><em>Phase 2 placeholder. Content lands in Phase 3 and 4.</em></p>
</BaseLayout>
