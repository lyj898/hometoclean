---
import BaseLayout from '../layouts/BaseLayout.astro';
import { urls } from '../lib/urls';
import { meta } from '../lib/seo';

const { title, description } = meta(
  'Page Not Found | HomeToClean',
  'The page you are looking for does not exist. Browse cleaning services, pricing by property size, or the towns we cover across Singapore.',
);
---

<BaseLayout title={title} description={description} path={"/404/"} noindex={true}>
  <h1>Page not found</h1>
  <p>That page does not exist. These might help:</p>
  <ul>
    <li><a href={urls.home()}>Home</a></li>
    <li><a href={urls.pricing()}>Cleaning prices in Singapore</a></li>
    <li><a href={urls.areas()}>Areas we cover</a></li>
    <li><a href={urls.contact()}>Get a quote</a></li>
  </ul>
</BaseLayout>
