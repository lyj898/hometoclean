---
/**
 * /pricing/
 *
 * Also the internal link hub for every service and property type, so nothing is
 * orphaned in the crawl graph.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';

import { urls } from '../lib/urls';
import { meta } from '../lib/seo';
import { publishedServices, publishedPropertyTypes, company } from '../lib/data';

const path = urls.pricing();
const services = publishedServices();
const propertyTypes = publishedPropertyTypes();

const { title, description } = meta(
  'Cleaning Prices in Singapore 2026 | HomeToClean',
  'What home cleaning actually costs in Singapore, by service and property size. Hourly versus flat rate explained, with the GST position stated plainly.',
);

const sgd = (n: number): string => n.toLocaleString('en-SG');

const faqs = [
  {
    q: 'Are these prices quotes?',
    a: 'No. They are indicative market ranges compiled from published Singapore sources, so you can judge whether a quote you receive is reasonable. Your actual price comes from the vendor after they understand your home. Anyone giving a firm price for a deep clean or post-renovation job without asking about size and condition is guessing.',
  },
  {
    q: 'Do these prices include GST?',
    a: `No. Every figure on this site is stated before GST, which is currently ${company.gstRatePercent}% in Singapore. Whether GST is added to your invoice depends on whether the vendor is GST-registered, which turns on their annual turnover. Ask before booking, because on a S$500 deep clean it is a S$45 difference.`,
  },
  {
    q: 'Why is a deep clean not just more hours of part-time cleaning?',
    a: 'Because the pricing basis is different, and that is the point. Part-time cleaning buys you time on site. Deep cleaning buys you a defined outcome for a fixed price, and if the job overruns that is the vendor’s problem rather than yours. A deep clean quoted to you hourly has quietly moved that risk back onto you.',
  },
  {
    q: 'Does my town affect the price?',
    a: 'Less than you would think. Property size is the dominant factor, followed by the condition and age of the finishes. Location matters mainly through travel time: vendors quote more readily and more cheaply for estates they already work in, which is why availability in the far north and far west can be thinner at short notice.',
  },
  {
    q: 'Is it cheaper to book a recurring cleaner than a one-off?',
    a: 'Per session, yes, usually by 10 to 20 percent. A recurring slot lets the vendor plan a route around it, so the travel and scheduling cost per visit falls and that saving is passed on. Note that almost all vendors enforce a 3 to 4 hour minimum per session either way.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  batch={0}
  crumbs={[{ name: 'Pricing', path }]}
>
  <section class="border-b border-line bg-surface">
    <div class="wrap py-12 sm:py-16">
      <div class="max-w-3xl">
        <h1 class="text-3xl font-semibold sm:text-4xl lg:text-5xl">
          What home cleaning costs in Singapore
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-ink-muted">
          Indicative market ranges in Singapore dollars, stated before GST at
          {company.gstRatePercent}%. The single most useful thing to understand before
          you book is whether what you are buying is billed by the hour or as a flat
          rate, because conflating the two is how most people overpay.
        </p>
      </div>
    </div>
  </section>

  {/* The distinction that the whole page turns on. */}
  <Section tone="canvas">
    <h2 class="text-2xl font-semibold sm:text-3xl">Hourly, flat rate, or per item</h2>
    <div class="mt-8 grid gap-5 lg:grid-cols-3">
      <div class="rounded-card border border-line bg-surface p-6">
        <h3 class="font-semibold">Billed by the hour</h3>
        <p class="mt-1 text-sm font-medium text-brand">Part-time cleaning</p>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">
          You buy time on site. A 3 to 4 hour minimum per session is near-universal, so
          a small flat still pays the minimum. If the home needs more than the booked
          hours, something gets left.
        </p>
      </div>
      <div class="rounded-card border border-line bg-surface p-6">
        <h3 class="font-semibold">Flat rate for the job</h3>
        <p class="mt-1 text-sm font-medium text-brand">
          Deep, move-in, move-out, post-renovation, spring
        </p>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">
          You buy a defined outcome for an agreed price, set from property size and
          condition. If the job overruns, that is the vendor's risk. A flat-rate service
          quoted to you hourly has moved that risk onto you.
        </p>
      </div>
      <div class="rounded-card border border-line bg-surface p-6">
        <h3 class="font-semibold">Per item</h3>
        <p class="mt-1 text-sm font-medium text-brand">Mattress and sofa cleaning</p>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">
          Priced per piece: sofas by seater count, mattresses by bed size. The total is
          known before anyone arrives. Most vendors set a minimum order value.
        </p>
      </div>
    </div>
  </Section>

  {/* By service. */}
  <Section tone="surface">
    <h2 class="text-2xl font-semibold sm:text-3xl">Price by service</h2>
    <div class="mt-8 overflow-x-auto">
      <table class="w-full min-w-[40rem] border-collapse text-left text-sm">
        <caption class="sr-only">
          Indicative Singapore cleaning prices by service, before GST
        </caption>
        <thead>
          <tr class="border-b border-line-strong">
            <th scope="col" class="py-3 pr-4 font-semibold">Service</th>
            <th scope="col" class="py-3 pr-4 font-semibold">Basis</th>
            <th scope="col" class="py-3 pr-4 font-semibold">Typical range</th>
            <th scope="col" class="py-3 font-semibold">Notes</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          {services.map((s) => (
            <tr>
              <th scope="row" class="py-4 pr-4 align-top font-medium">
                <a href={urls.service(s.slug)} class="text-brand no-underline hover:underline">
                  {s.name}
                </a>
              </th>
              <td class="py-4 pr-4 align-top text-ink-muted">{s.priceRangeSGD.unit}</td>
              <td class="py-4 pr-4 align-top font-medium text-ink whitespace-nowrap">
                {s.priceRangeSGD.min !== null && s.priceRangeSGD.max !== null
                  ? `S$${sgd(s.priceRangeSGD.min)}–${sgd(s.priceRangeSGD.max)}`
                  : 'On request'}
              </td>
              <td class="py-4 align-top text-ink-muted">{s.shortDescription}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Section>

  {/* By property size. */}
  <Section tone="canvas">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-semibold sm:text-3xl">Price by property size</h2>
      <p class="mt-4 text-ink-muted">
        Cleaning prices key off property size far more than off location, so this is
        usually the more useful table. Bathroom count moves the number more than floor
        area does.
      </p>
    </div>

    <div class="mt-8 overflow-x-auto">
      <table class="w-full min-w-[40rem] border-collapse text-left text-sm">
        <caption class="sr-only">
          Indicative Singapore cleaning prices by property type, before GST
        </caption>
        <thead>
          <tr class="border-b border-line-strong">
            <th scope="col" class="py-3 pr-4 font-semibold">Property type</th>
            <th scope="col" class="py-3 pr-4 font-semibold">Floor area</th>
            <th scope="col" class="py-3 pr-4 font-semibold">Routine clean</th>
            <th scope="col" class="py-3 font-semibold">Deep clean</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          {propertyTypes.map((p) => (
            <tr>
              <th scope="row" class="py-3.5 pr-4 font-medium">
                <a href={urls.propertyType(p.slug)} class="text-brand no-underline hover:underline">
                  {p.name}
                </a>
              </th>
              <td class="py-3.5 pr-4 text-ink-muted whitespace-nowrap">
                {p.floorAreaSqft.min}&ndash;{p.floorAreaSqft.max} sqft
              </td>
              <td class="py-3.5 pr-4 text-ink-muted whitespace-nowrap">
                {p.regularCleanHours.min}&ndash;{p.regularCleanHours.max} hours
              </td>
              <td class="py-3.5 text-ink-muted whitespace-nowrap">
                {p.deepCleanFlatRateSGD !== null
                  ? `S$${sgd(p.deepCleanFlatRateSGD.min)}–${sgd(p.deepCleanFlatRateSGD.max)}`
                  : 'Site visit required'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-8 rounded-card border border-sand-deep/40 bg-sand/40 p-5">
      <p class="text-sm leading-relaxed text-ink">
        <strong class="font-semibold">A quote well below these ranges is a question, not a bargain.</strong>{' '}
        In Singapore's licensed cleaning sector the Progressive Wage Model sets a basic
        wage floor of S$2,080 a month for a resident cleaner from 1 July 2026, before
        employer CPF, insurance, transport and supplies. That floor is a licence
        condition and does not bind an operator doing only domestic work, but it still
        tells you what compliant labour costs.{' '}
        <a href={urls.vendorStandards()} class="font-semibold text-brand no-underline hover:underline">
          What we check before matching a vendor
        </a>.
      </p>
    </div>
  </Section>

  <Section tone="surface" narrow>
    <h2 class="text-2xl font-semibold sm:text-3xl">Pricing questions</h2>
    <div class="mt-8">
      <FaqList faqs={faqs} />
    </div>
  </Section>

  <CtaBand
    heading="Get real quotes for your home."
    body="Ranges only get you so far. Tell us your town and property type and vendors will quote you directly."
  />
</BaseLayout>
