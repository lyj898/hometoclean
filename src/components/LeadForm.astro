---
/**
 * Enquiry form.
 *
 * Structure and mechanism deliberately mirror ourkampung.com: four fields
 * (Name, Email, Mobile optional, Message), a `_honey` honeypot, and an AJAX
 * POST to FormSubmit with a `_subject` in the payload.
 *
 * FormSubmit needs a one-time activation. The first submission sends a
 * confirmation link to the destination inbox; until that link is clicked,
 * nothing is delivered. After activating, swap the address in
 * company.formSubmit.endpoint for the hashed alias FormSubmit provides, so the
 * inbox address stops appearing in page source where scrapers can read it.
 */
import { FORM_ENDPOINT, FORM_SUBJECT, hasFormEndpoint } from '../lib/contact';
import { urls } from '../lib/urls';

const field =
  'mt-1.5 w-full rounded-lg border border-line-strong bg-surface px-3.5 py-2.5 text-base text-ink placeholder:text-ink-faint focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/25';
const label = 'block text-sm font-medium text-ink';
---

{!hasFormEndpoint() && (
  <p class="mb-6 rounded-card border border-warning/40 bg-sand/40 p-4 text-sm text-ink">
    <strong class="font-semibold">This form is not connected yet.</strong> Set
    <code class="font-mono text-2xs">formSubmit.endpoint</code> in
    <code class="font-mono text-2xs">src/data/company.json</code> before going live.
  </p>
)}

<div data-lead-region>
<form data-lead-form novalidate class="space-y-5">
  <div>
    <label class={label} for="cf-name">Your name</label>
    <input id="cf-name" class={field} name="Name" type="text" autocomplete="name" placeholder="e.g. Rachel" />
  </div>

  <div>
    <label class={label} for="cf-email">Email</label>
    <input id="cf-email" class={field} name="Email" type="email" autocomplete="email" placeholder="you@email.com" />
  </div>

  <div>
    <label class={label} for="cf-phone">
      Mobile <span class="font-normal text-ink-faint">(optional)</span>
    </label>
    <input id="cf-phone" class={field} name="Mobile" type="tel" inputmode="tel" autocomplete="tel" placeholder="e.g. 8123 4567" />
  </div>

  <div>
    <label class={label} for="cf-msg">How can we help?</label>
    <textarea
      id="cf-msg"
      class={field}
      name="Message"
      rows="5"
      placeholder="Tell us what you need cleaned - your town, flat type, which service, and when you would like it done."
    ></textarea>
  </div>

  {/* Honeypot. Real people never fill this in; bots usually do. */}
  <input
    type="text"
    name="_honey"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
    style="position:absolute;left:-9999px"
  />

  <button
    type="submit"
    data-lead-submit
    class="w-full rounded-lg bg-brand px-6 py-4 text-base font-semibold text-white transition-colors hover:bg-brand-dark disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
  >
    Send message
  </button>

  {/* Live region so the outcome is announced, not only shown. */}
  <p data-lead-status role="status" aria-live="polite" class="hidden text-sm font-medium"></p>

  <p class="text-2xs leading-relaxed text-ink-faint">
    We usually reply within one working day. By sending this message you agree that we
    may contact you about your enquiry and pass your details to the cleaning vendors
    matched to it, so they can quote you. See our
    <a href={urls.privacy()} class="underline underline-offset-2">Privacy Policy</a>.
  </p>
</form>

{/*
  Success state. Replaces the form rather than sitting under it: a reset form
  with a line of small text below it reads as "nothing happened, and my typing
  is gone", which is precisely the wrong signal after someone has just sent an
  enquiry.
*/}
<div data-lead-success hidden class="rounded-card border border-brand/30 bg-brand-light/60 p-6 sm:p-8">
  <div class="flex gap-4">
    <span class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-full bg-brand text-white">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4.5 10.5 8 14l7.5-8" />
      </svg>
    </span>
    <div>
      <h2 class="text-xl font-semibold text-ink sm:text-2xl">
        Thank you. Your message is on its way.
      </h2>
      <p class="mt-3 leading-relaxed text-ink-muted">
        We usually reply within one working day. We will match your enquiry to cleaning
        vendors who cover your estate, and they will quote you directly.
      </p>
      <p class="mt-3 leading-relaxed text-ink-muted">
        There is nothing else you need to do. If it is urgent, or you realise you left
        something out, send another message below.
      </p>

      <button
        type="button"
        data-lead-again
        class="mt-6 rounded-lg bg-surface px-5 py-2.5 text-sm font-semibold text-brand ring-1 ring-line-strong transition-colors hover:bg-brand-light"
      >
        Send another message
      </button>
    </div>
  </div>
</div>
</div>

<script is:inline define:vars={{ FORM_ENDPOINT, FORM_SUBJECT }}>
  (function () {
    var form = document.querySelector('[data-lead-form]');
    if (!form) return;

    var status = form.querySelector('[data-lead-status]');
    var submit = form.querySelector('[data-lead-submit]');
    var success = document.querySelector('[data-lead-success]');
    var again = success && success.querySelector('[data-lead-again]');
    var started = false;

    function showSuccess() {
      form.hidden = true;
      success.hidden = false;
      // Move focus to the confirmation so screen reader users land on it, and
      // bring it into view for everyone else. Without this the page can stay
      // scrolled where the form used to be.
      success.setAttribute('tabindex', '-1');
      success.focus({ preventScroll: true });
      success.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }

    if (again) {
      again.addEventListener('click', function () {
        success.hidden = true;
        form.hidden = false;
        started = false;
        form.scrollIntoView({ block: 'start', behavior: 'smooth' });
        var first = form.querySelector('[name="Name"]');
        if (first) first.focus({ preventScroll: true });
      });
    }

    function track(name, params) {
      if (typeof window.gtag === 'function') window.gtag('event', name, params || {});
    }

    function show(message, ok) {
      if (!status) return;
      status.textContent = message;
      status.classList.remove('hidden');
      status.style.color = ok ? 'var(--color-positive)' : 'var(--color-warning)';
    }

    // form_start: first focus into any field, once per page view. Held in a
    // closure variable - this site uses no localStorage or sessionStorage.
    form.addEventListener('focusin', function () {
      if (started) return;
      started = true;
      track('form_start', { page_path: window.location.pathname });
    });

    form.addEventListener('submit', function (event) {
      event.preventDefault();

      var name = form.querySelector('[name="Name"]').value.trim();
      var email = form.querySelector('[name="Email"]').value.trim();
      var mobile = form.querySelector('[name="Mobile"]').value.trim();
      var msg = form.querySelector('[name="Message"]').value.trim();
      var honey = form.querySelector('[name="_honey"]').value;

      // Silently succeed for bots rather than telling them they were caught.
      if (honey) {
        showSuccess();
        return;
      }

      if (!name || !/^\S+@\S+\.\S+$/.test(email) || !msg) {
        show('Please add your name, a valid email, and a message.', false);
        return;
      }

      if (!FORM_ENDPOINT) {
        show('This form is not connected yet. Please try again later.', false);
        return;
      }

      submit.disabled = true;
      show('Sending your message…', true);

      fetch(FORM_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          _subject: FORM_SUBJECT,
          Name: name,
          Email: email,
          Mobile: mobile || '-',
          Message: msg,
          Page: window.location.pathname,
        }),
      })
        .then(function (res) {
          if (!res.ok) throw new Error('HTTP ' + res.status);
          return res.json();
        })
        .then(function (data) {
          // FormSubmit answers 200 even when it refuses the submission - an
          // unactivated form returns { success: "false" }. Checking res.ok
          // alone would show a success message for a message nobody received,
          // and would record a conversion that never happened.
          var ok = data && (data.success === true || data.success === 'true');
          if (!ok) throw new Error((data && data.message) || 'rejected');

          // form_submit fires on genuine delivery only.
          track('form_submit', { page_path: window.location.pathname });
          form.reset();
          submit.disabled = false;
          if (status) status.classList.add('hidden');
          showSuccess();
        })
        .catch(function () {
          submit.disabled = false;
          show('Sorry, that did not send. Please try again in a moment.', false);
        });
    });
  })();
</script>
