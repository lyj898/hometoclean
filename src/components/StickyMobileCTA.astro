---
/**
 * Sticky bottom CTA, mobile only.
 *
 * Single action, because the enquiry form is the only contact channel: there is
 * no WhatsApp or telephone route on this site.
 */
import { urls } from '../lib/urls';
---

<div
  class="fixed inset-x-0 bottom-0 z-50 border-t border-line bg-surface/98 backdrop-blur-sm lg:hidden"
  style="padding-bottom: env(safe-area-inset-bottom)"
>
  <div class="px-3 py-2.5">
    <a
      href={urls.contact()}
      class="flex items-center justify-center rounded-lg bg-brand px-4 py-3.5 text-sm font-semibold text-white no-underline"
    >
      Get a free quote
    </a>
  </div>
</div>
