---
/**
 * FAQ list. Native <details>, so it works without JS and costs no hydration.
 * FAQ sections exist for users — see src/lib/schema.ts on why FAQPage markup is
 * not treated as a ranking lever.
 */
import type { Faq } from '../types';

interface Props {
  faqs: Faq[];
}

const { faqs } = Astro.props;
---

<div class="divide-y divide-line border-y border-line">
  {faqs.map((faq) => (
    <details class="group">
      <summary
        class="flex cursor-pointer list-none items-start justify-between gap-4 py-5 text-left font-semibold text-ink [&::-webkit-details-marker]:hidden"
      >
        <span>{faq.q}</span>
        <span
          aria-hidden="true"
          class="mt-1 shrink-0 text-ink-faint transition-transform duration-150 group-open:rotate-45"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
            <path d="M8 3v10M3 8h10" />
          </svg>
        </span>
      </summary>
      <p class="pb-5 pr-8 text-ink-muted">{faq.a}</p>
    </details>
  ))}
</div>
