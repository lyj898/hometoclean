---
/** Vertical rhythm wrapper. Keeps section spacing consistent across every page. */
interface Props {
  id?: string;
  tone?: 'canvas' | 'surface' | 'sunk' | 'brand';
  class?: string;
  narrow?: boolean;
}

const { id, tone = 'canvas', class: className = '', narrow = false } = Astro.props;

const tones = {
  canvas: '',
  surface: 'bg-surface',
  sunk: 'bg-surface-sunk',
  brand: 'bg-brand text-white',
} as const;
---

<section id={id} class={`py-14 sm:py-20 ${tones[tone]} ${className}`}>
  <div class={narrow ? 'wrap-narrow' : 'wrap'}>
    <slot />
  </div>
</section>
