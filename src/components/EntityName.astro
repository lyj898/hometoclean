---
/**
 * The registered entity name.
 *
 * Renders as plain text by default. Linking to the entity's own site is
 * opt-in via `link`, and is deliberately used on /about/ only: that is the
 * page where the relationship between the two businesses is explained, so the
 * link has context there and would be noise everywhere else.
 */
import { company } from '../lib/data';

interface Props {
  /** Link the name to the entity's own website. Off by default. */
  link?: boolean;
  class?: string;
}

const { link = false, class: className = '' } = Astro.props;
const href = link ? company.entityUrl?.trim() : '';
---

{href ? (
  <a
    href={href}
    rel="noopener"
    target="_blank"
    class={`text-brand no-underline hover:underline ${className}`}
  >{company.entityName}</a>
) : (
  <span class={className}>{company.entityName}</span>
)}
