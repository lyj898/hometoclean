---
/**
 * Site footer. Says who runs the site: the OurKampung team. The family names
 * no company (6 Oct 2026), so there is no registered name, UEN, address or
 * founding year here.
 */
import { company, services, propertyTypes, isBatchPublished } from '../lib/data';
import { urls } from '../lib/urls';

const year = new Date().getFullYear();

const liveServices = services.filter((s) => isBatchPublished(s.batch));
const liveProperties = propertyTypes.filter((p) => isBatchPublished(p.batch));
---

<footer class="border-t border-line bg-surface-sunk">
  <div class="wrap py-14">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="text-base font-bold tracking-tight text-ink">
          Home<span class="text-brand">To</span>Clean
        </p>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">
          {company.businessModelStatement}
        </p>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-ink">Services</h2>
        <ul class="mt-3 space-y-2">
          {liveServices.map((s) => (
            <li>
              <a href={urls.service(s.slug)} class="text-sm text-ink-muted no-underline hover:text-brand">
                {s.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-ink">By property size</h2>
        <ul class="mt-3 space-y-2">
          {liveProperties.map((p) => (
            <li>
              <a href={urls.propertyType(p.slug)} class="text-sm text-ink-muted no-underline hover:text-brand">
                {p.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-ink">Company</h2>
        <ul class="mt-3 space-y-2">
          <li><a href={urls.about()} class="text-sm text-ink-muted no-underline hover:text-brand">About</a></li>
          <li><a href={urls.vendorStandards()} class="text-sm text-ink-muted no-underline hover:text-brand">Vendor standards</a></li>
          <li><a href={urls.pricing()} class="text-sm text-ink-muted no-underline hover:text-brand">Pricing</a></li>
          <li><a href={urls.areas()} class="text-sm text-ink-muted no-underline hover:text-brand">Areas we cover</a></li>
          <li><a href={urls.contact()} class="text-sm text-ink-muted no-underline hover:text-brand">Contact</a></li>
          <li><a href={urls.privacy()} class="text-sm text-ink-muted no-underline hover:text-brand">Privacy policy</a></li>
          <li><a href={urls.terms()} class="text-sm text-ink-muted no-underline hover:text-brand">Terms of service</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-line pt-8">
      <address class="text-sm not-italic leading-relaxed text-ink-muted">
        <strong class="font-semibold">{company.brandName}</strong>
        <span> is run by the {company.family.name} team.</span><br />
        <a href={urls.contact()} class="font-medium text-brand no-underline">Send us a message</a>
        <br />
        <span>{company.operatingHoursDisplay}</span>
      </address>

      {/* The one sitewide link to another family site, by the family's own
          rule. nofollow: it is for readers, not rankings. */}
      <p class="mt-6 text-sm text-ink-muted">
        Part of
        <a href={company.family.url} rel="nofollow" class="font-medium text-ink-muted underline underline-offset-2 hover:text-brand">{company.family.name}</a>
      </p>

      <p class="mt-3 text-2xs leading-relaxed text-ink-faint">
        &copy; {year} {company.brandName}.
        Prices shown on this site are indicative market ranges in Singapore dollars
        and are not quotations.
      </p>
    </div>
  </div>
</footer>
