# Copy to .env for local development, and set these in the Cloudflare Pages
# dashboard for production. Only PUBLIC_ variables reach the browser.

# GA4 measurement ID, e.g. G-XXXXXXXXXX.
# Leave empty and the analytics script is not emitted at all — the site then
# ships zero JavaScript on every page except /contact/.
PUBLIC_GA4_ID=

# Where the lead form POSTs. Must accept application/json and respond 2xx.
# Leave empty and the form renders in a disabled state with an explanation,
# rather than silently discarding enquiries.
PUBLIC_LEAD_ENDPOINT=
